# Environment Configuration - Copy to .env

# ==================== Application ====================
ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# ==================== Database ====================
DATABASE_URL=postgresql://playwright:playwright123@localhost:5432/execution_farm
# Format: postgresql://user:password@host:port/database

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
# For production: redis://prod-host:6379

# ==================== Server ====================
PORT=8000
HOST=0.0.0.0
WORKERS=4
RELOAD=true

# ==================== JWT (Authentication) ====================
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600  # seconds (1 hour)
JWT_SECRET=your-jwt-secret-change-in-production

# ==================== Worker Pool ====================
DEFAULT_POOL_ID=pool-default
MIN_WORKERS=1
MAX_WORKERS=10
AUTO_SCALE=true
DEFAULT_WORKER_TIMEOUT=300  # seconds

# ==================== Tunnel (V5) ====================
TUNNEL_PROVIDER=local  # local, cloudflare, ngrok, ssh
TUNNEL_AUTH_TOKEN=
TUNNEL_DOMAIN=tunnel.local

# Cloudflare Tunnel
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ngrok
NGROK_AUTH_TOKEN=

# SSH Tunnel
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PRIVATE_KEY_PATH=

# ==================== Storage ====================
UPLOAD_DIR=./uploads
RESULT_DIR=./results
MAX_UPLOAD_SIZE=1073741824  # 1GB in bytes

# ==================== Browser Matrix (V7) ====================
SUPPORTED_BROWSERS=chrome,firefox,safari
SUPPORTED_DEVICES=desktop,mobile,tablet

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000  # milliseconds

# ==================== Reporting (V8) ====================
ALLURE_ENABLED=true
ALLURE_RESULTS_DIR=./results/allure
SCREENSHOT_ENABLED=true
TRACE_ENABLED=true

# ==================== Billing (V10) ====================
BILLING_ENABLED=false
STRIPE_API_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# ==================== Multi-Tenant (V10) ====================
MULTI_TENANT_ENABLED=true
DEFAULT_WORKSPACE_QUOTA=1000  # jobs per month

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
SENTRY_DSN=

# ==================== Monitoring ====================
PROMETHEUS_ENABLED=false
DATADOG_ENABLED=false
NEW_RELIC_LICENSE_KEY=

# ==================== Email (Notifications) ====================
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@execution-farm.com

# ==================== Integrations ====================
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITLAB_TOKEN=
JIRA_URL=
JIRA_TOKEN=

# ==================== Security ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# ==================== Cache ====================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_BACKEND=redis  # redis or memory

# ==================== Docker ====================
DOCKER_SOCKET_URL=unix:///var/run/docker.sock
DOCKER_IMAGE=execution-farm:latest

# ==================== AWS (Optional) ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ==================== Google Cloud (Optional) ====================
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=

# ==================== Azure (Optional) ====================
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
