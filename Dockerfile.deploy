# Slim image for the HOSTED SERVER (agent dispatcher + dashboard).
# No Playwright/Chromium here on purpose — the server never runs a browser,
# it only talks to agents. This keeps the image small and the build fast,
# which matters a lot on a free/cheap hosting tier.
#
# NOTE: the old direct-execution endpoints under /jobs (Phase 1-2, running
# pytest on the server itself) will NOT work with this image, since pytest
# and the browsers aren't installed here. Use the /agents/... endpoints
# instead (see agent/README.md) — that's the flow described in this project.

FROM python:3.11-slim

WORKDIR /app

COPY requirements-deploy.txt .
RUN pip install --no-cache-dir -r requirements-deploy.txt

COPY api ./api
COPY worker ./worker
COPY tests ./tests

ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
